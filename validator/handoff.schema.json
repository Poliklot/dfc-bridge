{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poliklot.github.io/bridge-design-methodology/schema/handoff.schema.json",
  "title": "DFC Bridge read-only developer snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "revision",
    "generator",
    "source",
    "scope",
    "nodes",
    "dependencies",
    "preflight",
    "coverage"
  ],
  "properties": {
    "format": {
      "const": "dfc-bridge-handoff"
    },
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginVersion",
        "validatorVersion"
      ],
      "properties": {
        "pluginVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "validatorVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileKey",
        "figmaPageId",
        "figmaPageName"
      ],
      "properties": {
        "fileKey": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{6,100}$"
            }
          ]
        },
        "figmaPageId": {
          "$ref": "#/$defs/nodeId"
        },
        "figmaPageName": {
          "type": "string",
          "pattern": "^[\\s\\S]{0,2400}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "completeness",
        "rootIds",
        "pageId"
      ],
      "properties": {
        "kind": {
          "enum": [
            "page",
            "section"
          ]
        },
        "completeness": {
          "enum": [
            "full",
            "partial"
          ]
        },
        "rootIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "pageId": {
          "type": "string",
          "pattern": "^[\\s\\S]{0,2400}$"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "preflight": {
      "type": "object",
      "required": [
        "mode",
        "scope",
        "status",
        "issues",
        "summary"
      ],
      "properties": {
        "mode": {
          "enum": [
            "page",
            "section"
          ]
        },
        "scope": {
          "enum": [
            "page",
            "selection"
          ]
        },
        "status": {
          "enum": [
            "ready",
            "review",
            "not-ready",
            "partial",
            "blocked"
          ]
        },
        "issues": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "required": [
              "ruleId",
              "severity",
              "nodeId"
            ],
            "properties": {
              "ruleId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$"
              },
              "severity": {
                "enum": [
                  "error",
                  "warning",
                  "todo"
                ]
              },
              "nodeId": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "object"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceInteriors",
        "content",
        "runtime",
        "componentVariants",
        "unavailable"
      ],
      "properties": {
        "instanceInteriors": {
          "const": "atomic"
        },
        "content": {
          "const": "not-checked"
        },
        "runtime": {
          "const": "not-checked"
        },
        "componentVariants": {
          "enum": [
            "not-exported",
            "inspected"
          ]
        },
        "unavailable": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodeId",
              "field",
              "reason"
            ],
            "properties": {
              "nodeId": {
                "$ref": "#/$defs/nodeId"
              },
              "field": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "componentInspection": {
      "$ref": "#/$defs/componentInspection"
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^I?[0-9]{1,20}:[0-9]{1,20}(?:;[0-9]{1,20}:[0-9]{1,20}){0,40}$"
    },
    "nullableNodeId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/nodeId"
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "parentId",
        "children",
        "mainComponentId",
        "figmaPageId",
        "identity",
        "native",
        "tags",
        "supportsChildren"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Z_]{1,80}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[\\s\\S]{0,2400}$"
        },
        "parentId": {
          "$ref": "#/$defs/nullableNodeId"
        },
        "children": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "mainComponentId": {
          "$ref": "#/$defs/nullableNodeId"
        },
        "figmaPageId": {
          "$ref": "#/$defs/nullableNodeId"
        },
        "identity": {
          "type": "string"
        },
        "native": {
          "$ref": "#/$defs/native"
        },
        "tags": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[\\s\\S]{0,2400}$"
                },
                {
                  "const": true
                }
              ]
            }
          }
        },
        "supportsChildren": {
          "type": "boolean"
        }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "visible": {
          "type": "boolean"
        },
        "isMask": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number"
        },
        "layoutMode": {
          "enum": [
            "NONE",
            "HORIZONTAL",
            "VERTICAL",
            "GRID"
          ]
        },
        "layoutPositioning": {
          "enum": [
            "AUTO",
            "ABSOLUTE"
          ]
        },
        "layoutSizingHorizontal": {
          "type": "string"
        },
        "layoutSizingVertical": {
          "type": "string"
        },
        "primaryAxisSizingMode": {
          "type": "string"
        },
        "counterAxisSizingMode": {
          "type": "string"
        },
        "primaryAxisAlignItems": {
          "type": "string"
        },
        "counterAxisAlignItems": {
          "type": "string"
        },
        "layoutWrap": {
          "type": "string"
        },
        "paddingTop": {
          "type": "number"
        },
        "paddingRight": {
          "type": "number"
        },
        "paddingBottom": {
          "type": "number"
        },
        "paddingLeft": {
          "type": "number"
        },
        "itemSpacing": {
          "type": "number"
        },
        "characters": {
          "type": "string"
        },
        "fontName": {
          "type": "object"
        },
        "fontSize": {
          "type": "number"
        },
        "fontWeight": {
          "type": "number"
        },
        "lineHeight": {
          "type": "object"
        },
        "letterSpacing": {
          "type": "object"
        },
        "textAlignHorizontal": {
          "type": "string"
        },
        "textAlignVertical": {
          "type": "string"
        },
        "textAutoResize": {
          "type": "string"
        },
        "fills": {
          "type": "array"
        },
        "strokes": {
          "type": "array"
        },
        "strokeWeight": {
          "type": "number"
        },
        "strokeAlign": {
          "type": "string"
        },
        "effects": {
          "type": "array"
        },
        "cornerRadius": {
          "type": "number"
        },
        "topLeftRadius": {
          "type": "number"
        },
        "topRightRadius": {
          "type": "number"
        },
        "bottomLeftRadius": {
          "type": "number"
        },
        "bottomRightRadius": {
          "type": "number"
        },
        "fillStyleId": {
          "type": "string"
        },
        "strokeStyleId": {
          "type": "string"
        },
        "textStyleId": {
          "type": "string"
        },
        "effectStyleId": {
          "type": "string"
        },
        "boundVariables": {
          "type": "object"
        },
        "explicitVariableModes": {
          "type": "object"
        },
        "resolvedVariableModes": {
          "type": "object"
        },
        "componentProperties": {
          "type": "object"
        },
        "overrides": {
          "type": "array"
        },
        "reactions": {
          "type": "array"
        },
        "exportSettings": {
          "type": "array"
        }
      }
    },
    "inspectionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "type",
        "name",
        "native",
        "styles",
        "variables"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "native": {
          "$ref": "#/$defs/native"
        },
        "styles": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object"
          }
        },
        "variables": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "componentVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "properties",
        "nodes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "name": {
          "type": "string"
        },
        "properties": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "nodes": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/inspectionNode"
          }
        }
      }
    },
    "componentFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "key",
        "propertyDefinitions",
        "axes",
        "variants",
        "remote",
        "sourceFileKey",
        "figmaPageId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "name": {
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "propertyDefinitions": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "axes": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "variants": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/componentVariant"
          }
        },
        "remote": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sourceFileKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "figmaPageId": {
          "$ref": "#/$defs/nullableNodeId"
        }
      }
    },
    "componentInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "families",
        "instances"
      ],
      "properties": {
        "families": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/componentFamily"
          }
        },
        "instances": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node",
              "mainComponentId",
              "familyId"
            ],
            "properties": {
              "node": {
                "$ref": "#/$defs/inspectionNode"
              },
              "mainComponentId": {
                "$ref": "#/$defs/nullableNodeId"
              },
              "familyId": {
                "$ref": "#/$defs/nullableNodeId"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "componentInspection"
        ],
        "properties": {
          "coverage": {
            "properties": {
              "componentVariants": {
                "const": "inspected"
              }
            },
            "type": "object"
          },
          "componentInspection": {
            "$ref": "#/$defs/componentInspection"
          }
        }
      },
      "else": {
        "properties": {
          "coverage": {
            "properties": {
              "componentVariants": {
                "const": "not-exported"
              }
            },
            "type": "object"
          },
          "componentInspection": false
        }
      }
    }
  ]
}
