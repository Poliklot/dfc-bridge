{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poliklot.github.io/bridge-design-methodology/schema/content-bindings.schema.json",
  "title": "DFC Bridge explicit saved-content bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "snapshotRevision",
    "groups"
  ],
  "properties": {
    "format": {
      "const": "dfc-bridge-content-bindings"
    },
    "schemaVersion": {
      "const": 1
    },
    "snapshotRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "sources"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,119}$"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contextId",
                "instanceId",
                "slots"
              ],
              "properties": {
                "contextId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,119}$"
                },
                "instanceId": {
                  "type": "string",
                  "pattern": "^I?[0-9]{1,20}:[0-9]{1,20}(?:;[0-9]{1,20}:[0-9]{1,20}){0,40}$"
                },
                "slots": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "key",
                      "kind"
                    ],
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,119}$"
                      },
                      "kind": {
                        "enum": [
                          "text-property",
                          "image-fill"
                        ]
                      },
                      "property": {
                        "type": "string",
                        "pattern": "^[\\s\\S]{1,2400}$"
                      },
                      "fillIndex": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "kind": {
                              "const": "text-property"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "property": {
                              "type": "string",
                              "pattern": "^[\\s\\S]{1,2400}$"
                            },
                            "fillIndex": false
                          },
                          "required": [
                            "property"
                          ]
                        },
                        "else": {
                          "properties": {
                            "fillIndex": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 10000
                            },
                            "property": false
                          },
                          "required": [
                            "fillIndex"
                          ]
                        }
                      }
                    ]
                  }
                },
                "exceptions": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "slotKey",
                      "reason"
                    ],
                    "properties": {
                      "slotKey": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,119}$"
                      },
                      "reason": {
                        "type": "string",
                        "pattern": "^[\\s\\S]{1,2400}$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
