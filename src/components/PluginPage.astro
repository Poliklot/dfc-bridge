---
interface Props {
  locale: 'ru' | 'en' | 'zh';
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const url = (path: string) => `${base}/${locale}/${path.replace(/^\//u, '')}`;
const pluginUrl = 'https://www.figma.com/community/plugin/1654485530503673254';

const copy = locale === 'ru'
  ? {
      eyebrow: 'Проверка макета',
      title: 'Выберите способ проверки.',
      lead: 'Плагин проверяет поддерживаемые правила в выбранной области. Дополните результат чеклистом дизайнера; для передачи всей команде используйте полную проверку.',
      navLabel: 'Способы проверки',
      designer: 'Чеклист дизайнера',
      full: 'Полная проверка',
      plugin: 'Проверка в Figma',
      pluginEyebrow: 'DFC Bridge Assistant · Figma',
      pluginTitle: 'Проверьте макет прямо в файле.',
      pluginLead: 'Необязательный помощник для методологии DFC Bridge помогает добавить смысл слоям, увидеть карту файла и перейти от замечания к точному месту. Он не создаёт готовое приложение и не заменяет проверку работающего интерфейса.',
      open: 'Открыть DFC Bridge Assistant',
      start: 'Установите плагин через Figma Community. Для проверки выберите корневой фрейм подготовленной страницы или корневой слой отдельной секции. Исправьте найденное замечание и повторите проверку в той же области.',
      startLink: 'Как подготовить первый макет',
      capabilitiesLabel: 'Что делает плагин',
      capabilities: [
        ['Добавляет смысл', 'Помогает разметить слой без ручного набора синтаксиса.'],
        ['Показывает карту', 'Показывает страницы, цели и места, требующие решения.'],
        ['Находит пробелы', 'Открывает нужный слой и объясняет, что исправить.'],
      ],
      trust: 'Доступен через Figma Community · отдельный аккаунт DFC Bridge не нужен',
      newTab: 'откроется в новой вкладке',
    }
  : locale === 'zh'
    ? {
      eyebrow: '检查设计',
      title: '选择检查方式。',
      lead: '插件检查选定范围内已支持的规则。请用设计师清单补充检查；向团队交付前，再完成全面审核。',
      navLabel: '检查方式',
      designer: '设计师清单',
      full: '完整检查',
      plugin: '在 Figma 中检查',
      pluginEyebrow: 'DFC Bridge Assistant · Figma',
      pluginTitle: '直接在文件中检查设计。',
      pluginLead: '这是 DFC Bridge 方法论的可选助手，帮助为图层添加含义、查看文件地图，并从问题跳到相关位置。它不会生成完整应用，也不能代替对运行中界面的验证。',
      open: '打开 DFC Bridge Assistant',
      start: '先从 Figma Community 安装插件。检查前，选择已准备页面的根画框或独立区块的根图层。修正发现的问题后，在相同范围内重新检查。',
      startLink: '如何准备第一份设计',
      capabilitiesLabel: '插件功能',
      capabilities: [
        ['添加含义', '无需手工拼接语法即可标记图层。'],
        ['查看地图', '展示页面、目标和仍需决定的位置。'],
        ['发现缺口', '打开相关图层并说明需要修正的内容。'],
      ],
      trust: '可从 Figma Community 获取 · 不需要 DFC Bridge 账号',
      newTab: '将在新标签页打开',
    }
  : {
      eyebrow: 'Design check',
      title: 'Choose a way to check the design.',
      lead: 'The plugin checks supported rules within the chosen scope. Follow up with the designer checklist; use the full review for a team handoff.',
      navLabel: 'Review options',
      designer: 'Designer checklist',
      full: 'Full review',
      plugin: 'Check in Figma',
      pluginEyebrow: 'DFC Bridge Assistant · Figma',
      pluginTitle: 'Check the design directly in the file.',
      pluginLead: 'The optional companion to the DFC Bridge methodology helps add meaning to layers, see the file map, and move from an issue to the exact place. It does not create a finished application or replace testing the running interface.',
      open: 'Open DFC Bridge Assistant',
      start: 'Install the plugin from Figma Community. Before checking, select the root frame of a prepared page or the root layer of a separate section. Correct a reported issue and rerun the check in the same scope.',
      startLink: 'Prepare your first design',
      capabilitiesLabel: 'What the plugin does',
      capabilities: [
        ['Add meaning', 'Helps tag a layer without handwritten syntax.'],
        ['Show the map', 'Shows pages, targets, and places that need a decision.'],
        ['Find gaps', 'Opens the affected layer and explains what to fix.'],
      ],
      trust: 'Available from Figma Community · no separate DFC Bridge account required',
      newTab: 'opens in a new tab',
    };
---

<div class="plugin-page check-hub not-content">
  <section class="check-hub-hero" aria-labelledby="_top">
    <p class="bridge-eyebrow">{copy.eyebrow}</p>
    <h1 id="_top">{copy.title}</h1>
    <p>{copy.lead}</p>
    <nav aria-label={copy.navLabel}>
      <a href="#figma-page-check"><span aria-hidden="true">→</span>{copy.plugin}</a>
      <a href={url('check/designer-checklist/')}><span aria-hidden="true">→</span>{copy.designer}</a>
      <a href={url('check/full-review/')}><span aria-hidden="true">→</span>{copy.full}</a>
    </nav>
  </section>

  <section id="figma-page-check" class="plugin-brief" aria-labelledby="plugin-title">
    <div class="plugin-brief-copy">
      <p class="bridge-eyebrow">{copy.pluginEyebrow}</p>
      <h2 id="plugin-title">{copy.pluginTitle}</h2>
      <p class="plugin-brief-lead">{copy.pluginLead}</p>
      <p class="plugin-brief-start">{copy.start} <a href={url('start/designer-quick-start/')}>{copy.startLink}</a>.</p>
      <a
        class="plugin-brief-cta bridge-button bridge-button-primary"
        href={pluginUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.open}<span aria-hidden="true"> ↗</span><span class="sr-only"> — {copy.newTab}</span>
      </a>
    </div>

    <ul class="plugin-capabilities" aria-label={copy.capabilitiesLabel}>
      {copy.capabilities.map(([title, description], index) => (
        <li>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <strong>{title}</strong>
          <p>{description}</p>
        </li>
      ))}
    </ul>

    <footer class="plugin-brief-meta">
      <p>{copy.trust}</p>
    </footer>

  </section>
</div>
