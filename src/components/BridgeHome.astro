---
interface Props {
  locale: 'ru' | 'en' | 'zh';
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const url = (path: string) => `${base}/${locale}/${path.replace(/^\//u, '')}`;

const copy = locale === 'ru'
  ? {
      eyebrow: 'Методология передачи макета',
      title: 'Макет, который можно понять без созвона.',
      lead: 'DFC Bridge помогает записать в макете, что это за страница, какие элементы повторяются на разных ширинах и что делают кнопки. Разработчику не приходится угадывать.',
      primary: 'Подготовить макет',
      secondary: 'Проверить в Figma',
      mapTitle: 'Карта макета',
      mapReady: 'Связи объявлены',
      mapFrames: 'Адаптивы',
      mapAction: 'Действие',
      mapNote: 'Одна страница, два адаптива и связанное модальное окно.',
      compareEyebrow: 'Один макет — одна понятная структура',
      compareTitle: 'Что меняется после DFC Bridge',
      compareIntro: 'Например, кнопка «Связаться» на двух ширинах должна открывать одно и то же окно. Одинаковые имена помогают узнать элементы. Записи в квадратных скобках уточняют их смысл — это метки в именах слоёв, не код.',
      without: 'Без DFC Bridge',
      with: 'С DFC Bridge',
      withoutNote: 'Названия показывают внешний вид, но не объясняют связи и действия.',
      withNote: 'Видно, какие макеты относятся к одной странице и какое окно должна открыть кнопка. Теги сами не создают раскладку или работающее поведение.',
      beforeTree: ['desktop', '  frame-42', '    heading', '    button', '', 'mobile-final-2', '  group-91', '    title'],
      afterTree: [
        'home [page=home] [bp=1440] [view=default]',
        '  hero [section=home-hero]',
        '    hero-title',
        '    contact-button [action=modal:contact-modal]',
        '  contact-modal [modal=contact-modal]',
        '',
        'home [page=home] [bp=375] [view=default]',
        '  hero [section=home-hero]',
        '    hero-title',
        '    contact-button [action=modal:contact-modal]',
        '  contact-modal [modal=contact-modal]',
      ],
      stepsEyebrow: 'Как начать',
      stepsTitle: 'Три действия до передачи',
      steps: [
        ['01', 'Выберите часть макета', 'Начните с одной страницы или новой секции и её нужных ширин.'],
        ['02', 'Запишите недостающие решения', 'Сохраните имена тех же элементов. Укажите, куда ведут ссылки и что делают кнопки.'],
        ['03', 'Проверьте понятность', 'Попросите коллегу найти эти элементы и их цели. Если пришлось объяснять устно — дополните файл.'],
      ],
      pathsEyebrow: 'Выберите следующий шаг',
      paths: [
        ['Подготовить макет', 'Короткий путь для первого файла.', 'Открыть быстрый старт', 'start/designer-quick-start/'],
        ['Проверить файл', 'Чеклист, полная проверка и плагин в Figma.', 'Открыть проверку', 'check/'],
        ['Зачем нужен DFC Bridge', 'Одна история о вопросах команды и решениях передачи.', 'Посмотреть визуальный экскурс', 'start/visual-walkthrough/'],
      ],
      outcomesEyebrow: 'Что получает команда',
      outcomesTitle: 'Меньше догадок, больше решений в самом файле.',
      outcomes: [
        ['Дизайнер', 'Видит пропуски до передачи макета.'],
        ['Разработчик', 'Находит нужный слой, действие и состояние.'],
        ['Команда', 'Отличает принятые решения от открытых вопросов.'],
      ],
      finalTitle: 'Начните с одной страницы.',
      finalText: 'Не нужно переносить весь архив. Возьмите реальный файл, подготовьте его по быстрому старту и проверьте передачу без автора.',
      finalAction: 'Открыть быстрый старт',
    }
  : locale === 'zh'
    ? {
      eyebrow: '设计交付方法论',
      title: '无需会议也能看懂的设计。',
      lead: 'DFC Bridge 帮你在设计中写清：这是哪个页面、哪些元素在不同宽度下是同一个、按钮要做什么。开发者不必猜测。',
      primary: '准备设计',
      secondary: '在 Figma 中检查',
      mapTitle: '设计地图',
      mapReady: '已声明关系',
      mapFrames: '响应式',
      mapAction: '动作',
      mapNote: '一个页面、两个响应式版本和一个关联模态框。',
      compareEyebrow: '一份设计 — 一套清晰结构',
      compareTitle: '使用 DFC Bridge 后有什么不同',
      compareIntro: '例如，两个宽度下的“联系”按钮都应打开同一个弹窗。相同名称帮助识别对应元素。方括号中的内容补充其含义：它们是图层名称中的标签，不是代码。',
      without: '未使用 DFC Bridge',
      with: '使用 DFC Bridge',
      withoutNote: '名称描述外观，却没有说明关系和动作。',
      withNote: '可以看出哪些设计属于同一页面，以及按钮应打开哪个弹窗。标签本身不会创建布局或可运行的行为。',
      beforeTree: ['desktop', '  frame-42', '    heading', '    button', '', 'mobile-final-2', '  group-91', '    title'],
      afterTree: [
        'home [page=home] [bp=1440] [view=default]',
        '  hero [section=home-hero]',
        '    hero-title',
        '    contact-button [action=modal:contact-modal]',
        '  contact-modal [modal=contact-modal]',
        '',
        'home [page=home] [bp=375] [view=default]',
        '  hero [section=home-hero]',
        '    hero-title',
        '    contact-button [action=modal:contact-modal]',
        '  contact-modal [modal=contact-modal]',
      ],
      stepsEyebrow: '如何开始',
      stepsTitle: '交付前的三个动作',
      steps: [
        ['01', '选定设计范围', '从一个页面或新区块及其所需宽度开始。'],
        ['02', '补充缺少的决定', '同一元素保留同一名称。写清链接去哪、按钮做什么。'],
        ['03', '检查能否看懂', '请同事找到这些元素及其目标。需要口头解释的地方，就补进文件。'],
      ],
      pathsEyebrow: '选择下一步',
      paths: [
        ['准备设计', '从第一份文件开始。', '打开快速起步', 'start/designer-quick-start/'],
        ['检查文件', '查看清单、完整检查或 Figma 插件。', '打开检查', 'check/'],
        ['为什么需要 DFC Bridge', '一个交付故事，说明团队疑问与决策。', '查看图解入门', 'start/visual-walkthrough/'],
      ],
      outcomesEyebrow: '团队收益',
      outcomesTitle: '减少猜测，让决定留在文件中。',
      outcomes: [
        ['设计师', '在交付前发现缺失信息。'],
        ['开发', '直接找到图层、动作和状态。'],
        ['团队', '区分已确定的决定与未决问题。'],
      ],
      finalTitle: '从一个真实页面开始。',
      finalText: '不需要迁移整个存档。选一份真实文件，按快速起步准备，再让作者以外的人独立完成检查。',
      finalAction: '打开快速起步',
    }
  : {
      eyebrow: 'Design handoff methodology',
      title: 'A design file people can understand without a call.',
      lead: 'DFC Bridge helps record which page a design shows, which elements are the same across widths, and what buttons do. Developers do not have to guess.',
      primary: 'Prepare a design',
      secondary: 'Check in Figma',
      mapTitle: 'Design map',
      mapReady: 'Connections declared',
      mapFrames: 'Prepared widths',
      mapAction: 'Action',
      mapNote: 'One page at two prepared widths, with a connected modal.',
      compareEyebrow: 'One design — one clear structure',
      compareTitle: 'What changes with DFC Bridge',
      compareIntro: 'For example, the Contact button at both widths should open the same modal. Matching names help identify the same elements. Square brackets add their meaning: these are tags in layer names, not code.',
      without: 'Without DFC Bridge',
      with: 'With DFC Bridge',
      withoutNote: 'Names describe appearance, but not relationships or actions.',
      withNote: 'You can tell which designs belong to one page and which modal the button should open. Tags do not create layout or working behavior.',
      beforeTree: ['desktop', '  frame-42', '    heading', '    button', '', 'mobile-final-2', '  group-91', '    title'],
      afterTree: [
        'home [page=home] [bp=1440] [view=default]',
        '  hero [section=home-hero]',
        '    hero-title',
        '    contact-button [action=modal:contact-modal]',
        '  contact-modal [modal=contact-modal]',
        '',
        'home [page=home] [bp=375] [view=default]',
        '  hero [section=home-hero]',
        '    hero-title',
        '    contact-button [action=modal:contact-modal]',
        '  contact-modal [modal=contact-modal]',
      ],
      stepsEyebrow: 'How to start',
      stepsTitle: 'Three actions before handoff',
      steps: [
        ['01', 'Choose a design scope', 'Start with one page or new section and the widths it needs.'],
        ['02', 'Record missing decisions', 'Keep the same names for the same elements. State where links lead and what buttons do.'],
        ['03', 'Check understanding', 'Ask a teammate to find those elements and their targets. Add any missing explanation to the file.'],
      ],
      pathsEyebrow: 'Choose the next step',
      paths: [
        ['Prepare a design', 'A short path for the first file.', 'Open quick start', 'start/designer-quick-start/'],
        ['Review a file', 'The checklist, full review, and Figma plugin.', 'Open review', 'check/'],
        ['Why DFC Bridge matters', 'One story about team questions and handoff decisions.', 'Read the visual introduction', 'start/visual-walkthrough/'],
      ],
      outcomesEyebrow: 'What the team gets',
      outcomesTitle: 'Fewer guesses, more decisions in the file.',
      outcomes: [
        ['Designer', 'Finds missing information before handoff.'],
        ['Developer', 'Finds the exact layer, action, and state.'],
        ['Team', 'Distinguishes agreed decisions from open questions.'],
      ],
      finalTitle: 'Start with one page.',
      finalText: 'You do not need to migrate the archive. Take a real file, follow the quick start, and test the handoff without the author.',
      finalAction: 'Open quick start',
    };
---

<div class="bridge-home bridge-home-simple not-content">
  <section class="bridge-hero" aria-labelledby="_top">
    <div class="bridge-hero-copy">
      <p class="bridge-eyebrow">{copy.eyebrow}</p>
      <h1 id="_top">{copy.title}</h1>
      <p class="bridge-lead">{copy.lead}</p>
      <div class="bridge-actions">
        <a class="bridge-button bridge-button-primary" href={url('start/designer-quick-start/')}>{copy.primary}</a>
        <a class="bridge-button bridge-button-secondary" href={url('check/')}>{copy.secondary}</a>
      </div>
    </div>
    <figure class="bridge-handoff-map" aria-labelledby="handoff-map-title">
      <figcaption class="bridge-handoff-toolbar">
        <span id="handoff-map-title">{copy.mapTitle}</span>
        <span class="bridge-handoff-status"><i aria-hidden="true"></i>{copy.mapReady}</span>
      </figcaption>
      <div class="bridge-handoff-body">
        <div class="bridge-handoff-index">
          <div>
            <span>{copy.mapFrames}</span>
            <strong>home</strong>
            <small>1440 · 375</small>
          </div>
          <div>
            <span>{copy.mapAction}</span>
            <strong>contact-modal</strong>
            <small>contact-button</small>
          </div>
        </div>
        <div class="bridge-handoff-canvas" aria-hidden="true">
          <svg viewBox="0 0 360 210" preserveAspectRatio="none">
            <path d="M148 62 C194 62 184 142 228 142" />
            <path d="M148 62 C210 62 210 51 260 51" />
          </svg>
          <div class="bridge-map-frame bridge-map-frame--desktop">
            <span>home · 1440</span>
            <div><b></b><i></i><i></i></div>
            <code>home-hero</code>
          </div>
          <div class="bridge-map-frame bridge-map-frame--mobile">
            <span>home · 375</span>
            <div><b></b><i></i></div>
          </div>
          <div class="bridge-map-frame bridge-map-frame--modal">
            <span>contact-modal</span>
            <div><i></i><b></b></div>
          </div>
        </div>
      </div>
      <p class="bridge-handoff-note">{copy.mapNote}</p>
    </figure>
  </section>

  <section class="bridge-section bridge-home-compare" aria-labelledby="compare-title">
    <p class="bridge-eyebrow">{copy.compareEyebrow}</p>
    <h2 id="compare-title">{copy.compareTitle}</h2>
    <p>{copy.compareIntro}</p>
    <div class="bridge-compare-grid">
      <article class="bridge-compare-card">
        <header><span>01</span><h3>{copy.without}</h3></header>
        <pre tabindex="0">{copy.beforeTree.join('\n')}</pre>
        <p>{copy.withoutNote}</p>
      </article>
      <article class="bridge-compare-card bridge-compare-card--good">
        <header><span>02</span><h3>{copy.with}</h3></header>
        <pre tabindex="0">{copy.afterTree.join('\n')}</pre>
        <p>{copy.withNote}</p>
      </article>
    </div>
  </section>

  <section class="bridge-section bridge-method" aria-labelledby="method-title">
    <div>
      <p class="bridge-eyebrow">{copy.stepsEyebrow}</p>
      <h2 id="method-title">{copy.stepsTitle}</h2>
    </div>
    <ol>
      {copy.steps.map(([number, title, description]) => (
        <li><span>{number}</span><div><h3>{title}</h3><p>{description}</p></div></li>
      ))}
    </ol>
  </section>

  <section class="bridge-section" aria-labelledby="paths-title">
    <p class="bridge-eyebrow">{copy.pathsEyebrow}</p>
    <div class="bridge-paths" id="paths-title">
      {copy.paths.map(([title, description, action, href]) => (
        <a class="bridge-path" href={url(href)}>
          <h3>{title}</h3>
          <p>{description}</p>
          <span class="bridge-path-action">{action}<span aria-hidden="true"> →</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="bridge-section bridge-outcomes" aria-labelledby="outcomes-title">
    <header>
      <p class="bridge-eyebrow">{copy.outcomesEyebrow}</p>
      <h2 id="outcomes-title">{copy.outcomesTitle}</h2>
    </header>
    <div>
      {copy.outcomes.map(([role, outcome]) => <article><h3>{role}</h3><p>{outcome}</p></article>)}
    </div>
  </section>

  <section class="bridge-final" id="bridge-final">
    <div><h2>{copy.finalTitle}</h2><p>{copy.finalText}</p></div>
    <a class="bridge-button bridge-button-primary" href={url('start/designer-quick-start/')}>{copy.finalAction}</a>
  </section>
</div>

<style>
  .bridge-handoff-map {
    overflow: hidden;
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--bridge-blue) 35%, var(--bridge-line));
    border-radius: 0.8rem;
    background: #151a1f;
    box-shadow: 0 1.4rem 4rem rgb(0 0 0 / 22%);
  }

  .bridge-handoff-toolbar {
    display: flex;
    min-height: 2.8rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid #2c343c;
    padding: 0.65rem 0.8rem 0.65rem 1rem;
    color: #f4f7f9;
    font-size: 0.76rem;
    font-weight: 650;
  }

  .bridge-handoff-toolbar::before {
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 auto;
    border: 1px solid #59636d;
    border-radius: 50%;
    box-shadow: 0.9rem 0 0 -1px #59636d, 1.8rem 0 0 -1px #59636d;
    content: '';
  }

  .bridge-handoff-toolbar > span:first-of-type {
    margin-inline-end: auto;
  }

  .bridge-handoff-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid #315e48;
    border-radius: 999px;
    background: #142c21;
    padding: 0.32rem 0.55rem;
    color: #9be3bc;
    font-size: 0.66rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .bridge-handoff-status i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: #5ed391;
    box-shadow: 0 0 0 0.18rem rgb(94 211 145 / 12%);
  }

  .bridge-handoff-body {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.36fr) minmax(0, 1fr);
    min-height: 15rem;
  }

  .bridge-handoff-index {
    border-inline-end: 1px solid #2c343c;
    background: #181e24;
    padding: 1rem 0.75rem;
  }

  .bridge-handoff-index > div {
    display: grid;
    gap: 0.25rem;
    padding: 0.65rem 0.55rem;
  }

  .bridge-handoff-index > div + div {
    margin-top: 0.6rem;
    border-top: 1px solid #2c343c;
    padding-top: 1.15rem;
  }

  .bridge-handoff-index span {
    color: #7fc8ff;
    font-family: var(--sl-font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .bridge-handoff-index strong {
    overflow: hidden;
    color: #f3f6f8;
    font: 600 0.73rem/1.35 var(--sl-font-mono);
    text-overflow: ellipsis;
  }

  .bridge-handoff-index small {
    color: #818b94;
    font: 0.58rem/1.4 var(--sl-font-mono);
  }

  .bridge-handoff-canvas {
    position: relative;
    overflow: hidden;
    min-width: 0;
    background-color: #10151a;
    background-image: radial-gradient(circle, #2a343d 0.65px, transparent 0.75px);
    background-size: 12px 12px;
  }

  .bridge-handoff-canvas svg {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .bridge-handoff-canvas path {
    fill: none;
    stroke: #379cf0;
    stroke-dasharray: 4 5;
    stroke-linecap: round;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .bridge-map-frame {
    position: absolute;
    z-index: 1;
    overflow: hidden;
    border: 1px solid #496071;
    border-radius: 0.28rem;
    background: #202932;
    box-shadow: 0 0.65rem 1.5rem rgb(0 0 0 / 22%);
  }

  .bridge-map-frame > span {
    display: block;
    overflow: hidden;
    border-bottom: 1px solid #36434e;
    padding: 0.32rem 0.42rem;
    color: #cbd3d9;
    font: 0.54rem/1 var(--sl-font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bridge-map-frame > div {
    display: grid;
    gap: 0.3rem;
    padding: 0.55rem;
  }

  .bridge-map-frame b,
  .bridge-map-frame i {
    display: block;
    height: 0.38rem;
    border-radius: 0.12rem;
    background: #485764;
  }

  .bridge-map-frame b {
    width: 72%;
    background: #55adf4;
  }

  .bridge-map-frame i:last-child {
    width: 58%;
  }

  .bridge-map-frame code {
    position: absolute;
    inset: auto 0.4rem 0.4rem auto;
    border: 1px solid #2f72a8;
    border-radius: 0.18rem;
    background: #17334a;
    padding: 0.18rem 0.3rem;
    color: #8ed0ff;
    font-size: 0.46rem;
  }

  .bridge-map-frame--desktop {
    top: 1.8rem;
    left: 1.35rem;
    width: 47%;
    height: 7.4rem;
    border-color: #3b9ce5;
    box-shadow: 0 0 0 1px rgb(59 156 229 / 18%), 0 0.65rem 1.5rem rgb(0 0 0 / 24%);
  }

  .bridge-map-frame--mobile {
    top: 1.8rem;
    right: 1.2rem;
    width: 21%;
    min-width: 3.6rem;
    height: 7.4rem;
  }

  .bridge-map-frame--modal {
    right: 2.3rem;
    bottom: 1.3rem;
    width: 35%;
    height: 4.5rem;
  }

  .bridge-map-frame--modal > div {
    grid-template-columns: 1fr 0.55fr;
  }

  .bridge-handoff-note {
    margin: 0;
    border-top: 1px solid #2c343c;
    padding: 0.8rem 1rem 0.9rem;
    color: #aab4bc;
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .bridge-home-compare h2 {
    margin-top: 0;
  }

  .bridge-compare-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .bridge-compare-card {
    overflow: hidden;
    border: 1px solid var(--bridge-line);
    border-radius: 0.65rem;
    background: var(--bridge-surface);
  }

  .bridge-compare-card--good {
    border-color: color-mix(in srgb, var(--bridge-blue) 60%, var(--bridge-line));
    background: var(--bridge-sky);
  }

  .bridge-compare-card header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    border-bottom: 1px solid var(--bridge-line);
    padding: 0.85rem 1rem;
  }

  .bridge-compare-card header span {
    color: var(--bridge-blue-deep);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }

  .bridge-compare-card h3 {
    margin: 0;
    font-size: 1rem;
  }

  .bridge-compare-card pre {
    min-height: 13rem;
    margin: 0;
    overflow-x: auto;
    padding: 1rem;
    color: var(--sl-color-white);
    font: 0.78rem/1.7 var(--sl-font-mono);
    white-space: pre;
  }

  .bridge-compare-card p {
    margin: 0;
    border-top: 1px solid var(--bridge-line);
    padding: 0.9rem 1rem 1rem;
    color: var(--bridge-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 48rem) {
    .bridge-compare-grid {
      grid-template-columns: 1fr;
    }

    .bridge-handoff-body {
      grid-template-columns: 7.75rem minmax(0, 1fr);
    }
  }
</style>
